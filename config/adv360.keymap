#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    // Layer index map (based on your file order):
    // 0: default_layer (Base)
    // 1: keypad
    // 2: fn
    // 3: mod
    // 4: extra1  (we'll use this as "Shift" layer for Real-Prog-Dvorak)

    default_layer {
      display-name = "Base (RPD)";
      bindings = <
        // number row (Real Programmers Dvorak base symbols)
        &kp LS(N4)   &kp LS(EQUAL) &kp LBKT     &kp LS(LBKT)  &kp LS(N9)  &kp LS(N7) &tog 1                                             &mo 3 &kp EQUAL    &kp LS(N0)  &kp LS(RBKT) &kp RBKT     &kp LS(N8)  &kp LS(BSLH)
        // top alpha row: ; , . p y f   |   g c r l / @ \
        &kp TAB      &kp SEMI      &kp COMMA   &kp DOT       &kp P       &kp Y      &kp BSLH                                              &none &kp G        &kp C       &kp R        &kp L        &kp FSLH    &kp AT
        // home row: a o e u i   |   d h t n s -
        &kp ESC      &kp A         &kp O       &kp E         &kp U       &kp I      &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL     &none &kp D        &kp H       &kp T        &kp N        &kp S       &kp MINUS
        // bottom alpha row (approx on your matrix): ' q j k x   |   b m w v z
        &mo 4        &kp SQT       &kp Q       &kp J         &kp K       &kp X                             &kp HOME &kp PG_UP                             &kp B        &kp M       &kp W        &kp V        &kp Z       &mo 4
        // thumbs / nav (kept as-is except GRAVE -> backslash to match RPD bottom-left "\")
        &mo 2        &kp BSLH      &kp CAPS    &kp LEFT      &kp RIGHT                 &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE              &kp UP &kp DOWN  &kp LBKT     &kp RBKT     &mo 2
      >;
    };

    keypad {
      display-name = "Kp (RPD)";
      bindings = <
        &kp LS(N4)   &kp LS(EQUAL) &kp LBKT     &kp LS(LBKT)  &kp LS(N9)  &kp LS(N7) &trans                                            &mo 3 &kp EQUAL    &kp KP_NUM  &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp LS(BSLH)
        &kp TAB      &kp SEMI      &kp COMMA    &kp DOT       &kp P       &kp Y      &kp BSLH                                           &none &kp G        &kp KP_N7   &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp AT
        &kp ESC      &kp A         &kp O        &kp E         &kp U       &kp I      &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL     &none &kp D        &kp KP_N4   &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp MINUS
        &mo 4        &kp SQT       &kp Q        &kp J         &kp K       &kp X                             &kp HOME &kp PG_UP                             &kp B        &kp KP_N1   &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &mo 4
        &mo 2        &kp BSLH      &kp CAPS     &kp LEFT      &kp RIGHT                 &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0               &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };

    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    // Real-Prog-Dvorak "Shift layer" (momentary on the physical Shift keys via &mo 4)
    extra1 {
      display-name = "Shift (RPD)";
      bindings = <
        // matches Prime's shift image row for the number row positions (best-effort on your matrix)
        &kp LS(GRAVE) &kp N1        &kp N2       &kp N3       &kp N4       &kp N5       &trans                                         &trans &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp GRAVE
        // : < > P Y F   |   G C R L ? ^ #
        &trans        &kp LS(SEMI)  &kp LT       &kp GT       &kp LS(P)    &kp LS(Y)    &kp HASH                                      &trans &kp LS(G)    &kp LS(C)    &kp LS(R)    &kp LS(L)    &kp QMARK    &kp CARET
        // A O E U I   |   D H T N S _
        &trans        &kp LS(A)     &kp LS(O)    &kp LS(E)    &kp LS(U)    &kp LS(I)    &trans        &trans &trans &trans &trans        &trans &kp LS(D)    &kp LS(H)    &kp LS(T)    &kp LS(N)    &kp LS(S)    &kp LS(MINUS)
        // | " Q J K X   |   B M W V Z
        &trans        &kp PIPE      &kp DQT      &kp LS(Q)    &kp LS(J)    &kp LS(K)                  &trans &trans                  &kp LS(B)    &kp LS(M)    &kp LS(W)    &kp LS(V)    &kp LS(Z)    &trans
        // keep thumbs/nav mostly passthrough (so you can still backspace/enter/etc while holding shift-layer)
        &trans        &kp PIPE      &trans       &trans       &trans                    &trans &trans   &trans   &trans   &trans   &trans                    &trans &trans &trans       &trans       &trans
      >;
    };

    extra2 {
      display-name = "Purple";
      status = "reserved";
    };

    extra3 {
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 {
      display-name = "Yellow";
      status = "reserved";
    };
  };
};
